DATABASE_URL="file:../data/hr.db"
EXCEL_SOURCE_PATH="D:/Tuhu-HR/途虎HR人员登记.xlsx"
EMPLOYEE_ID_PREFIX="THHR"

# 列表接口是否默认脱敏敏感字段（身份证 / 手机 / 银行卡 / 住址 / 薪资）
MASK_SENSITIVE_IN_LIST="true"

# 导入报告是否掩码员工姓名。
# false（默认）= 完整姓名，仅供内部审计使用，报告已被 .gitignore 排除，不要提交到 Git。
# true          = 姓名掩码为「张**」，此版本可安全提交到代码仓库。
REPORT_MASK_NAMES="false"

# 登录功能（第一阶段已预留，默认关闭）
AUTH_ENABLED="false"
AUTH_ADMIN_USERNAME="admin"
# 切勿在此写入真实密码；如需启用登录，请用 npm run db:seed 生成哈希后写入数据库
AUTH_ADMIN_PASSWORD=""
