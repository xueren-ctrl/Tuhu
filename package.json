{
  "name": "tuhu-hr",
  "version": "0.1.0",
  "private": true,
  "description": "途虎加盟店 HR 人事管理系统",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "db:studio": "prisma studio",
    "import:excel": "tsx scripts/import-excel.ts",
    "import:excel:reset": "tsx scripts/import-excel.ts --reset",
    "migrate:departments": "tsx scripts/migrate-departments.ts",
    "check:sensitive": "node scripts/pre-push-check.mjs",
    "test:stage1": "node scripts/acceptance-test.mjs",
    "test:stage2": "node scripts/stage2-test.mjs",
    "test:stage2:acceptance": "node scripts/stage2-acceptance.mjs",
    "test:stage3": "node scripts/stage3-test.mjs",
    "test:stage5": "tsx scripts/stage5-test.mjs",
    "test:stage6": "tsx scripts/stage6-test.mjs",
    "test:cleanup": "tsx scripts/cleanup-test-data.ts",
    "backup": "tsx scripts/backup-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "exceljs": "4.4.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
