{
  "name": "tuhu-hr",
  "version": "0.1.0",
  "private": true,
  "description": "途虎加盟店 HR 人事管理系统",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "serve": "node scripts/serve.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "firewall": "powershell -ExecutionPolicy Bypass -File scripts/firewall.ps1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "db:studio": "prisma studio",
    "import:excel": "tsx scripts/import-excel.ts",
    "import:excel:reset": "tsx scripts/import-excel.ts --reset",
    "migrate:departments": "tsx scripts/migrate-departments.ts",
    "check:sensitive": "node scripts/pre-push-check.mjs",
    "test:stage1": "node scripts/acceptance-test.mjs",
    "test:stage2": "node scripts/stage2-test.mjs",
    "test:stage2:acceptance": "node scripts/stage2-acceptance.mjs",
    "test:stage3": "node scripts/stage3-test.mjs",
    "test:stage5": "tsx scripts/stage5-test.mjs",
    "test:stage6": "tsx scripts/stage6-test.mjs",
    "test:stage6:security": "tsx scripts/stage6-security-test.mjs",
    "test:stage7.1": "tsx scripts/stage7-1-test.mjs",
    "test:seed-users": "tsx scripts/seed-users-test.mjs",
    "test:stage8": "node scripts/stage8-test.mjs",
    "test:tenure": "tsx scripts/tenure-test.mjs",
    "check:auth": "node scripts/check-auth-coverage.mjs",
    "test:cleanup": "tsx scripts/cleanup-test-data.ts",
    "backup": "tsx scripts/backup-db.ts",
    "import:sheets": "tsx scripts/import-sheets.mjs",
    "migrate:statuses": "node scripts/migrate-statuses.mjs",
    "test:stage9": "node scripts/stage9-test.mjs",
    "status:candidate": "node scripts/set-candidate-status.mjs",
    "link:sheet-rows": "node scripts/link-sheet-rows.mjs",
    "autostart": "node scripts/autostart.mjs",
    "autostart:once": "node scripts/autostart.mjs --once",
    "autostart:log": "node -e \"console.log(require('fs').readFileSync('logs/autostart.log','utf8').split('\\n').slice(-40).join('\\n'))\"",
    "autostart:off": "powershell -ExecutionPolicy Bypass -File scripts/setup-autostart.ps1 -Uninstall",
    "tunnel:status": "node -e \"try{const l=require('fs').readFileSync('logs/tunnel-url.txt','utf8').split('\\n');console.log('当前外网地址:',l.find(x=>x.startsWith('https://'))||'(隧道未运行)')}catch(e){console.log('当前外网地址: (隧道未运行)');}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "exceljs": "4.4.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
