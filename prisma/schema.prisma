// ============================================================
// 途虎加盟店 HR 人事管理系统 —— 数据库模型
// 数据库：SQLite     ORM：Prisma
//
// 设计原则（第一阶段）：
//  1. Employee 是唯一员工数据源，其他业务页面全部实时查询本表。
//  2. Excel「数据库」Sheet 的每一个原始字段都能落到 Employee 上，
//     暂不做过度拆表；后续再拆出 招聘 / 社保 / 薪资 / 合同 / 离职 子表。
//  3. 员工系统内部唯一标识为 employeeId（THHR+年份+6位流水号），
//     绝不使用 姓名 / 姓名+入职日期 / 身份证号 作为主键。
//  4. 身份证号只作为业务唯一性校验字段之一。
//  5. 删除采用软删除（deletedAt），不做物理删除。
//  6. 注意：SQLite 不支持 Prisma enum，状态字段使用 String，
//     取值受 lib/constants.ts 中的常量约束。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// 门店（基础设置，可增删改停用）
// ------------------------------------------------------------
model Store {
  id      Int     @id @default(autoincrement())
  name    String  @unique // 门店名称，来自 Excel「门店名称」
  code    String? // 门店编码（可选）
  region  String? // 区域 / 城市（可选）
  address String? // 门店地址（可选）
  // 计划编制人数（来自「门店人员编制」Sheet，第一阶段仅存参考值）
  plannedHeadcount Int?
  status    String  @default("ACTIVE") // ACTIVE | INACTIVE
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  aliases   StoreAlias[]
  rules     DepartmentRule[]

  @@index([status])
}

// ------------------------------------------------------------
// 门店别名（第三阶段新增）
// 用途：同一家门店在历史 Excel 里可能有多种写法（如「A店」「A途虎」「A服务店」）。
// 把非标准写法定为别名后，查询与统计统一归到标准门店（Store）名下。
//
// 关键设计：
// 1. 别名只存「字符串 + 指向标准门店的外键」，**不复制任何员工数据**。
// 2. 新增别名时会把 storeNameRaw 等于该别名的员工重新挂到标准门店
//    （只改 storeId 外键，storeNameRaw 原文保留不删，可追溯）。
// 3. alias 全局唯一：一个别名只能属于一家门店，避免归属歧义。
// ------------------------------------------------------------
model StoreAlias {
  id        Int      @id @default(autoincrement())
  storeId   Int
  alias     String   @unique // 别名原文，如「A途虎」
  note      String? // 备注 / 来源说明
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ------------------------------------------------------------
// 部门（第二阶段新增）
// 数据来源：Excel「运营部」「运营部离职」Sheet。
// 这些 Sheet 的业务含义是**部门**而非门店，因此从 Store 中独立出来。
// 说明：Excel 未提供门店员工的部门归属，因此门店员工的 departmentId 为 null，
//       系统不擅自为门店员工虚构部门（不用 mock 数据填充）。
// ------------------------------------------------------------
model Department {
  id          Int     @id @default(autoincrement())
  name        String  @unique // 部门名称，如「运营部」
  code        String? // 部门编码（可选）
  deptType    String? // 部门类型（可选：运营 / 职能 / 技术 …）
  managerName String? // 部门负责人（可选）
  sortOrder   Int     @default(0)
  status      String  @default("ACTIVE") // ACTIVE | INACTIVE
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  rules     DepartmentRule[]

  @@index([status])
}

// ------------------------------------------------------------
// 职位 / 工种（基础设置，可增删改停用）
// 数据来源：Excel「工种级别」列的历史取值
// ------------------------------------------------------------
model Position {
  id        Int     @id @default(autoincrement())
  name      String  @unique // 职位/工种名称，如 店长、机修、前台
  category  String? // 职位大类（预留：技术 / 服务 / 管理 / 职能）
  level     String? // 级别（预留：如 青铜 / 白银 / 黄金，对应 Excel「工种级别」的级别后缀）
  sortOrder Int     @default(0)
  status    String  @default("ACTIVE") // ACTIVE | INACTIVE
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  rules     DepartmentRule[]

  @@index([status])
}

// ------------------------------------------------------------
// 通用字典表（第一阶段只放必要字典，避免过度设计）
// category 例如：YES_NO_FLAG、DOC_STATUS、RESIGN_REASON、DORMITORY、ID_TYPE
// ------------------------------------------------------------
model DictOption {
  id        Int     @id @default(autoincrement())
  category  String
  code      String
  label     String
  sortOrder Int     @default(0)
  status    String  @default("ACTIVE") // ACTIVE | INACTIVE
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, code])
  @@index([category, status])
}

// ------------------------------------------------------------
// 员工主档案 —— 系统唯一员工数据源
// 字段顺序基本对齐 Excel「数据库」Sheet 的 46 列，便于人工核对
// ------------------------------------------------------------
model Employee {
  id         Int    @id @default(autoincrement()) // 内部主键（自增）
  employeeId String @unique // 业务唯一编号 THHR2026000001，永不修改

  // ---- ① 基本信息 --------------------------------------------------
  name                  String // 姓名（Excel col5）
  idCardNo              String? // 身份证号（Excel col6，字符串存储，禁止当数字）
  gender                String? // 性别（由身份证号推导，仅供统计，不落 Excel）
  age                   Int? // 年龄（Excel col28，清洗为整数）
  ageRaw                String? // 年龄原文，保留 Excel 原样
  minorNote             String? // 未成年备注（Excel col46）

  // ---- ② 联系方式 --------------------------------------------------
  phone            String? // 联系电话（Excel col7，字符串存储）
  currentAddress   String? // 现居住地址（Excel col24）
  emergencyContact1 String? // 紧急联系人1（Excel col12）
  emergencyPhone1   String? // 紧急联系人1电话（Excel col13）
  emergencyContact2 String? // 紧急联系人2（Excel col14）
  emergencyPhone2   String? // 紧急联系人2电话（Excel col15）

  // ---- ③ 门店 / 部门 / 职位 -----------------------------------------
  // 查询一律走外键（storeId / departmentId / positionId）；
  // 下面的 *Raw 原文列仅作「Excel 原始值留痕」，不参与查询与筛选。
  storeId           Int? // 关联 Store
  storeNameRaw      String? // Excel 原始门店名称（原文保留，历史数据不丢）
  departmentId      Int? // 关联 Department
  departmentNameRaw String? // Excel 原始部门名称（取自「运营部」等 Sheet）
  positionId        Int? // 关联 Position
  jobGradeRaw       String? // Excel「工种级别」原文，如「青铜机修技师」
  positionNote      String? // 职位备注（Excel col9）
  certificateLevel  String? // 证书级别（Excel col42）

  // ---- ④ 入职信息 --------------------------------------------------
  hireDate     DateTime? // 入职日期（Excel col3）
  dormitory    String? // 是否住宿舍（Excel col10）
  mentorName   String? // 带教人（Excel col39）
  onboardingMedical String? // 入职体检（Excel col20）

  // ---- ⑤ 社保（第一阶段仅存字段，不做业务逻辑）----------------------
  socialInsurancePurchased String? // 社保购买（Excel col11）

  // ---- ⑥ 薪资（第一阶段仅存字段，不做业务逻辑）----------------------
  salaryTerms         String? // 薪资待遇（Excel col23）
  firstMonthGuarantee String? // 首月保障（Excel col37）
  bankBranch          String? // 工资卡开户银行支行（Excel col21）
  bankAccountNo       String? // 银行卡账号（Excel col22，字符串存储，禁止当数字）

  // ---- ⑦ 合同 / 入职资料（第一阶段仅存字段）-------------------------
  laborContract          String? // 劳动合同（Excel col16）
  socialInsuranceAgreement String? // 社保协议（Excel col17）
  fireSafetyCommitment   String? // 消防承诺书（Excel col18）
  dormitoryWaiver        String? // 宿舍免责协议（Excel col19）
  docResume              String? // 简历表（Excel col34）
  docInterviewEvaluation String? // 面试评估表（Excel col35）
  docOnboardingForm      String? // 入职表（Excel col40）
  docInterviewEvaluation2 String? // 面试评估表（Excel col41，原表重复列名）

  // ---- ⑧ 离职 ------------------------------------------------------
  status        String    @default("ACTIVE") // ACTIVE | RESIGNED | CANDIDATE
  resignDate    DateTime? // 离职日期（Excel col27「备注（离职日期）」中可解析的日期部分）
  resignDateRaw String? // 离职日期原文（含 "9/30已离职" 之类文本，原样保留）
  resignReason  String? // 离职原因（Excel col26）

  // ---- ⑨ 招聘 / 面试（第一阶段仅存字段，不做完整招聘系统）------------
  recruiterName     String? // 招聘人（Excel col25）
  interviewDate     DateTime? // 面试时间（Excel col29）
  interviewLocation String? // 面试地点（Excel col30）
  interviewResult   String? // 面试结果（Excel col31）
  interviewerName   String? // 面试人（Excel col32）
  interviewHired    String? // 是否入职（Excel col33）

  // ---- ⑩ 备注 / 系统计算字段（原样保留以便追溯）----------------------
  remark             String? // 备注（Excel col38）
  remark3            String? // 备注（Excel col43，原表重复列名）
  computed7Days      String? // 是否满7天（Excel col44，公式/手工混合，仅存快照）
  computed2Months    String? // 是否入职满2个月（Excel col45，公式/手工混合，仅存快照）
  tenureTextAtImport String? // 导入时「在职年限」计算快照（Excel col4，计算字段）
  resignedTenureText String? // 导入时「在职年限（离职）」计算快照（Excel col36，计算字段）

  // ---- ⑪ 溯源 / 审计 -----------------------------------------------
  sourceSheet  String? // 来源 Sheet 名，默认「数据库」
  sourceRowNo  Int? // Excel 原始行号
  importBatch  String? // 导入批次号
  dataFlags    String? // 数据异常标记 JSON 数组，如 ["身份证号为空","手机号疑似填写在身份证列"]

  // ---- ⑫ 软删除 / 时间戳 -------------------------------------------
  deletedAt DateTime? // 软删除时间；非空表示已停用/删除
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store      Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)

  /** 该员工在原始 Excel 中对应的全部数据行（一行员工可能由多行 Excel 合并而来） */
  sourceRows EmployeeSourceRow[]

  /** 该员工的字段变更历史（第三阶段新增，所有修改自动留痕） */
  histories EmployeeHistory[]

  /** 该员工的数据质量工单（第四阶段新增） */
  qualityIssues QualityIssue[]

  @@index([name])
  @@index([phone])
  @@index([idCardNo])
  @@index([employeeId])
  @@index([storeId])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([deletedAt])
  @@index([hireDate])
}

// ------------------------------------------------------------
// 员工 ↔ 原始 Excel 行的溯源映射
//
// 为什么需要单独一张表：
//   Excel 中同一名员工可能出现多行（重复登记、同一段任职被录入两次）。
//   导入时这些行会合并到同一条 Employee 记录上，
//   若只把行号存在 Employee.sourceRowNo（单值），后一行会覆盖前一行，
//   下次重复导入时前一行就再也找不到归属 → 会重复创建员工。
//   因此这里用 (sheet, rowNo) 唯一索引持久化「每一个 Excel 行 → 员工」的映射，
//   保证导入脚本可无限次重复执行而不产生重复员工。
// ------------------------------------------------------------
model EmployeeSourceRow {
  id         Int      @id @default(autoincrement())
  employeeId Int
  sheet      String // 来源 Sheet 名，第一阶段固定为「数据库」
  rowNo      Int // Excel 原始行号
  batchId    String? // 首次建立该映射的导入批次
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([sheet, rowNo])
  @@index([employeeId])
}

// ------------------------------------------------------------
// employee_id 流水号计数器（每年一份，保证 THHR+年份+6位 永久唯一）
// ------------------------------------------------------------
model EmployeeIdCounter {
  year      Int      @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// 导入批次（用于可重复执行导入 + 审计）
// ------------------------------------------------------------
model ImportBatch {
  id           String   @id // 批次号，如 IMP-20260919-205600-abc123
  sourceFile   String // Excel 源文件绝对路径
  sourceSha256 String? // 源文件 SHA256，用于确认导入的是同一份原始文件
  sourceSheet  String
  totalRows    Int      @default(0) // 数据区总行数
  inserted     Int      @default(0)
  updated      Int      @default(0)
  unchanged    Int      @default(0) // 第五阶段：匹配到已有员工且字段完全一致、未写入的行
  skipped      Int      @default(0)
  duplicated   Int      @default(0)
  failed       Int      @default(0)
  issueCount   Int      @default(0)
  status       String   @default("RUNNING") // RUNNING | SUCCESS | PARTIAL | FAILED
  message      String?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  issues ImportIssue[]
}

// ------------------------------------------------------------
// 导入异常明细（不静默处理任何异常）
// ------------------------------------------------------------
model ImportIssue {
  id          Int     @id @default(autoincrement())
  batchId     String
  sourceRowNo Int? // 原始 Excel 行号
  employeeName String? // 员工姓名
  fieldName   String? // 异常字段
  rawValue    String? // 原始值
  issueType   String // MISSING_ID | INVALID_ID | FIELD_MISPLACED | INVALID_DATE | EMPTY_NAME | DUPLICATE_KEY | FALLBACK_MATCH | OTHER
  severity    String  @default("WARN") // WARN | ERROR
  message     String?
  createdAt   DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([issueType])
}

// ------------------------------------------------------------
// 系统用户（第一阶段只预留管理员 / HR普通用户两种角色）
// ------------------------------------------------------------
model AppUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String?
  passwordHash String // 仅存哈希，绝不存明文
  role         String   @default("HR") // ADMIN | HR
  status       String   @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------------
// 服务端会话（第六阶段新增）
//
// 登录成功后由服务端创建，HttpOnly Cookie 里**只存 sessionId**。
// 所有页面 / API 的真实身份都来自这里，绝不听信前端 localStorage
// 或客户端伪造的 x-operator 头。
//
// 字段对齐 spec：userId / username / role / createdAt / expiresAt。
// ------------------------------------------------------------
model Session {
  id            String   @id // sessionId（随机 hex）
  userId        Int
  username      String
  displayName   String?
  role          String   // ADMIN | HR
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastActiveAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------
// 操作审计日志（HR 敏感数据系统，保留变更痕迹）
// ------------------------------------------------------------
model AuditLog {
  id         Int      @id @default(autoincrement())
  actor      String? // 操作人
  action     String // CREATE | UPDATE | SOFT_DELETE | RESTORE | IMPORT
  entity     String // Employee | Store | Position | ...
  entityId   String?
  summary    String? // 变更摘要（严禁写入完整身份证号 / 银行卡号）
  detail     String? // 变更明细 JSON（敏感字段已脱敏）
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// 员工字段变更历史（第三阶段新增）
//
// 需求：记录 employeeId / 字段名称 / 修改前 / 修改后 / 操作时间 / 操作人，
//       所有员工修改操作自动记录。
//
// 设计要点：
// 1. 一个字段一行（fieldName / oldValue / newValue），便于按字段检索与还原；
//    一次提交改 3 个字段就写 3 行，用同一 batchKey 归组。
// 2. 同时存内部主键 employeeId 与业务编号 employeeCode（THHR…）：
//    前者用于关联，后者用于**离职/删档后仍可读**（外键级联删除也就不会丢历史）。
// 3. 敏感字段（身份证 / 银行卡 / 手机号 / 住址 / 薪资）只记录**脱敏后**的值，
//    与列表接口的脱敏口径一致，避免历史表成为新的泄露面。
// 4. 记录来源用 source 区分单条编辑 / 批量修改 / 新增 / 软删除 / 恢复。
// ------------------------------------------------------------
model EmployeeHistory {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employeeCode String? // 业务编号快照（THHR + 年份 + 6 位流水），便于脱库检索
  batchKey     String? // 同一次操作的多字段归组
  source       String   @default("UPDATE") // CREATE | UPDATE | BATCH_UPDATE | SOFT_DELETE | RESTORE
  fieldName    String // 字段名（Prisma 字段名）
  fieldLabel   String? // 字段中文名（界面展示用）
  oldValue     String? // 修改前（已脱敏）
  newValue     String? // 修改后（已脱敏）
  operator     String   @default("system") // 操作人（当前版本未启用登录，默认为系统）
  operatedAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, operatedAt])
  @@index([operatedAt])
  @@index([fieldName])
  @@index([batchKey])
}

// ------------------------------------------------------------
// 部门自动归属规则（第四阶段新增）
//
// 用途：按「门店 / 岗位 / 员工类型」三维度自动生成部门推荐，
//       解决 1902 名员工无部门归属的问题（Excel 未提供该信息）。
//
// 设计：
// 1. 规则只描述「什么样的人归到哪个部门」，不写死任何人 —— 只生成**推荐**，
//    由人在页面上预览、确认后才批量写入，且写入走标准更新流程（自带变更记录）。
// 2. 三个维度都是可选的，未填表示不限制；已填的维度之间是 AND 关系。
// 3. priority 越小优先级越高；一名员工命中多条规则时取优先级最高的那条。
// 4. employeeType 说明：源数据里**没有独立的「员工类型」字段**，
//    因此这一维用「工种级别原文 jobGradeRaw 包含该文本」来匹配
//    （如填「店长」可命中「技术店长」「副店长」等）。这一点在页面上明确标注，
//    不让用户误以为源数据里真有一个员工类型字段。
// ------------------------------------------------------------
model DepartmentRule {
  id            Int       @id @default(autoincrement())
  departmentId  Int
  storeId       Int? // 按门店匹配（为空=不限）
  positionId    Int? // 按岗位匹配（为空=不限）
  employeeType  String? // 按工种级别原文包含匹配（为空=不限）
  priority      Int       @default(100) // 越小越优先
  enabled       Boolean   @default(true)
  remark        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  store      Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  position   Position?  @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([enabled, priority])
  @@index([departmentId])
  @@index([storeId])
  @@index([positionId])
}

// ------------------------------------------------------------
// 数据质量问题工单（第四阶段新增）
//
// 用途：把数据质量中心从「只展示问题」升级为「有处理流程」——
//       每个问题可以有人认领、处理、关闭，关闭后统计口径立即变化。
//
// 设计：
// 1. (issueType, employeeId) 唯一 —— 同一员工同一类问题只有一张工单，
//    重复点击「关闭」是幂等的 upsert，不会产生重复记录。
// 2. 只存员工的**内部主键 + 业务编号快照**，不复制任何档案字段。
// 3. 状态：OPEN（待处理）/ CLOSED（已关闭）/ IGNORED（已忽略）。
//    统计口径：待处理 = 检出总数 - (CLOSED + IGNORED)。
// 4. 关闭是「人工确认这条不用管了」，不等于数据被改好 ——
//    因此 result 字段记录处理结果说明，避免后人看不懂为什么关掉。
// ------------------------------------------------------------
model QualityIssue {
  id          Int       @id @default(autoincrement())
  issueType   String // 与 data-quality-service 的类别 key 一致
  employeeId  Int
  employeeCode String? // 业务编号快照（THHR…）
  status      String    @default("OPEN") // OPEN | CLOSED | IGNORED
  handler     String? // 处理人
  handledAt   DateTime? // 处理时间
  result      String? // 处理结果说明
  note        String? // 备注
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([issueType, employeeId])
  @@index([issueType, status])
  @@index([status])
}

// ------------------------------------------------------------
// Excel 重新导入预览批次（第四阶段新增）
//
// 用途：避免「上传即覆盖」。流程固定为
//   上传 → 解析 → 生成 Diff → 人工确认 → 才正式写入
//
// 设计：
// 1. 上传的文件原样存到 data/import/，预览只记录**元信息与 Diff 结果**，
//    确认时基于同一份文件重新解析再写入，保证「所见即所写」。
// 2. 预览阶段**不碰 Employee 表**（这是验收点：预览后数据库必须零变化）。
// 3. diffJson 存完整差异明细（含每个员工的逐字段修改前后），
//    便于确认页展示，也便于事后审计。
// 4. 状态：PENDING → COMMITTED / DISCARDED。已提交或已丢弃的批次不能重复提交。
// ------------------------------------------------------------
model ImportPreview {
  id          String   @id // 预览批次号，如 PREVIEW-20260920-xxxx
  fileName    String
  fileSize    Int
  storedPath  String // 服务器上的文件相对路径（data/import/…）
  fileSha256  String? // 上传文件原始 SHA256（预览创建时计算），提交时复核文件未被替换
  sheetName   String
  totalRows   Int // 数据区总行数
  validRows   Int // 有效业务行数
  skippedRows Int // 跳过的空行
  diffJson    String // Diff 明细 JSON（**只含脱敏后的 display 值**，绝不含真实敏感值）
  summaryJson String // 汇总 JSON（新增 / 修改 / 未变化 / 跳过 / 异常 数量）
  status      String   @default("PENDING") // PENDING | COMMITTING | SUCCESS | PARTIAL | FAILED | DISCARDED
  operator    String?

  // ---- 第五阶段：数据库版本指纹 ----
  // 预览生成瞬间冻结的数据库状态；提交前重新计算并比对，
  // 不一致说明「预览之后有人改过数据」，直接拒绝提交（防止「页面看到 A、写入 B」）。
  dbVersion   String   @default("")

  // ---- 第六阶段：重试版本基线 ----
  // 每次提交成功后都会重新计算并写回「提交后的数据库指纹」。
  // 重试时以它为基线复核（而非预览创建时的 dbVersion），
  // 这样「首次提交改了库 → 重试前库又被别人改」才能被识别并拒绝，
  // 要求重新生成预览。首次提交用 dbVersion；重试用此值（首次提交成功后才有）。
  lastCommitDbVersion String?

  // ---- 第五阶段：提交结果 ----
  attemptCount  Int     @default(0) // 提交尝试次数（含重试）
  successCount  Int     @default(0) // 本次/累计成功写入条数
  failedCount   Int     @default(0) // 失败条数
  unchangedCount Int    @default(0) // 无变化、未写入条数
  resultJson    String? // 逐条结果明细（失败行号 / 原因），供只重试失败项

  createdAt   DateTime @default(now())
  committedAt DateTime?

  @@index([status, createdAt])
}

/// Stage 7.3.10：Excel 各 Sheet 的原样镜像。
/// 用户要求「软件里的表跟我的 Excel 一模一样」——对于没有对应 Employee 字段的 Sheet
/// （薪资表、招聘面试登记表等），最可靠的方式是把整行原样存下来，按 Excel 的列顺序渲染。
/// 只读镜像，不参与员工增删改查（那是 Employee 表的职责）。
model SheetRow {
  id        Int      @id @default(autoincrement())
  /// Sheet 名（在职 / 离职 / 南昌3店 / 运营部 / 招聘面试登记表 / 运营部离职 / 薪资表 / 数据库）
  sheet     String
  /// Excel 里的行号（从 1 开始），便于溯源
  rowNo     Int
  /// 该行的单元格值，JSON 数组（按列顺序，与表头一一对应）
  cellsJson String
  /// 表头，JSON 数组
  headersJson String
  /// 数据来源文件指纹（Excel SHA256），用于判断是否需要重新导入
  sourceSha String?
  importedAt DateTime @default(now())

  @@unique([sheet, rowNo])
  @@index([sheet])
}
